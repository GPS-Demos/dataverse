#GCP project id where the DC website will be installed in.
project_id ="gps-dataverse-468813"

#Contact email for domain. Must be a valid email and will be used for activating the domain.
#contact_email=""

#The prefix of the GCP service account to be created.
#website_robot_account_id=""

#Enabling this flag will register a new domain in Cloud Domains and configure the DNS in Cloud DNS.
register_domain=true

#Custom DC website domain to register. Will be ignored if register_domain is false.
#dc_website_domain=

#The cost of the domain, must be an exact match. Ex: 12.00 USD
#domain_yearly_price=

#DNS for the website domain. Please do not change this value.
#is_dns_public=

#Contact phone nubmer for domain in international format. Ex: +1.6502530000
#contact_phone_internaltional_format

#Contact region code(country equivalent) for the domain. Ex: US
#contact_region_code

#Contact postal code for the domain. Ex: 94043 for Google
#contact_postal_code

#Contact admin area(state equivalent) for the domain. Ex: CA
#contact_admin_area

#Contact locality(city equivalent) for the domain. Ex: Mountain View
#contact_locality


#If true then add a random suffix to the ending of GCP resource names to avoid name collision.
#use_resource_suffix

#The location of the resource buckets. Can either be regional or multi-regional.
#resource_bucket_location
