# Instructions:
#  - Copy this file to terraform.tfvars
#  - Replace variables with valid values
#  - [Optional] Add any additional variable values from variables.tf definition

# User's GCP project
project_id  = "gps-dataverse-dev-468813"

region = "us-central1"

# Namespace to prefix all resources created by Terraform. For example, the
# value "dev" results in resources like "dev-datacommons-web-service" and
# "dev-datacommons-data-job". This ensures unique names when deploying the
# module multiple times in the same GCP account.
namespace   = "dataverse-dev"

# Data Commons API key. See https://docs.datacommons.org/custom_dc/quickstart.html#prerequisites
dc_api_key = "gps-dataverse-api-key"

# Image Name
dc_web_service_image = "us-central1-docker.pkg.dev/gps-dataverse-dev-468813/gps-dataverse-dev-468813-artifacts/datacommons-services:latest"
